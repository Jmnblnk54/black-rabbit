# Full Calendly event URL for the /book inline embed
# (defaults to https://calendly.com/blackrabbitcreative/discovery)
NEXT_PUBLIC_CALENDLY_URL=

# Where inquiry submissions get emailed (Resend, etc.)
INQUIRY_FORWARD_TO=blackrabbitcreative@yahoo.com
RESEND_API_KEY=

# Mux (server-only) — used once real video upload kicks in
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# Cloudinary cloud name for next-cloudinary <CldImage>
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Public site URL (used in metadata + sitemap)
NEXT_PUBLIC_SITE_URL=https://blackrabbitcreative.com
